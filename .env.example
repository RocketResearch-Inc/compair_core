COMPAIR_EDITION=core

# Run in local single-user mode while developing
COMPAIR_REQUIRE_AUTHENTICATION=false
COMPAIR_REQUIRE_EMAIL_VERIFICATION=false

# SQLite-first local setup
COMPAIR_DB_DIR=.compair-data
COMPAIR_DB_NAME=compair.db

# Legacy/local defaults
COMPAIR_EMBEDDING_PROVIDER=local
COMPAIR_GENERATION_PROVIDER=local
COMPAIR_LOCAL_MODEL_URL=http://127.0.0.1:9000

# Optional legacy custom generation service.
COMPAIR_GENERATION_ENDPOINT=

# Optional if using OpenAI instead of local generation/embeddings
COMPAIR_OPENAI_API_KEY=
COMPAIR_OPENAI_MODEL=gpt-5-nano

# Optional OCR service
COMPAIR_OCR_ENDPOINT=http://127.0.0.1:9001/ocr-file
COMPAIR_OCR_REQUEST_TIMEOUT=30
# Retrieval is legacy by default. baseline_v1 is an explicit fail-closed opt-in.
COMPAIR_RETRIEVAL_ENGINE=legacy
COMPAIR_RETRIEVAL_QUERY_ALLOW_INSECURE_LOCAL_TRANSPORT=false

# Baseline control-plane writes require HTTPS. The HTTP exception is accepted
# only for a directly connected loopback peer when explicitly enabled. List
# trusted TLS-terminating proxy peer IPs/CIDRs here; forwarded headers from all
# other peers are ignored.
COMPAIR_BASELINE_CONTROL_PLANE_ALLOW_INSECURE_LOOPBACK=false
COMPAIR_BASELINE_CONTROL_PLANE_TRUSTED_PROXY_ALLOWLIST=

# Baseline submissions and the durable database worker are independently off.
COMPAIR_BASELINE_RUNS_ENABLED=false
COMPAIR_BASELINE_WORKER_MODE=manual
COMPAIR_BASELINE_WORKER_POLL_INTERVAL_SECONDS=2
COMPAIR_BASELINE_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
COMPAIR_BASELINE_WORKER_HEARTBEAT_TTL_SECONDS=30
COMPAIR_BASELINE_WORKER_CLEANUP_INTERVAL_SECONDS=30
COMPAIR_BASELINE_WORKER_MAX_PENDING_PER_SLOT=8
COMPAIR_BASELINE_WORKER_MAX_ATTEMPTS=5
COMPAIR_BASELINE_WORKER_MAX_BACKOFF_SECONDS=30

# This deliberately nonfunctional placeholder shows baseline-run-keyring.v1.
# Replace it only through the API and worker secret managers with an independent
# AES-256-GCM key. Never commit the replacement value.
COMPAIR_BASELINE_RUN_ENCRYPTION_KEYRING='{"version":"baseline-run-keyring.v1","active_key_id":"replace-me","keys":[{"key_id":"replace-me","key_base64":"REPLACE_WITH_BASE64_32_BYTE_KEY"}]}'
COMPAIR_BASELINE_RUN_PAYLOAD_TTL_SECONDS=900

# baseline_v1 embeddings are separate from legacy embeddings and fail closed.
# HTTP is permitted only for a directly connected loopback endpoint when the
# explicit exception is true; remote services require HTTPS. Installed model
# commands and the local service use the private cache below; serving never
# downloads model files.
COMPAIR_BASELINE_MODEL_CACHE=~/.cache/compair-core/models
COMPAIR_BASELINE_EMBEDDING_PROVIDER=disabled
COMPAIR_BASELINE_EMBEDDING_ENDPOINT=http://127.0.0.1:9010
COMPAIR_BASELINE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COMPAIR_BASELINE_EMBEDDING_REVISION=52398278842ec682c6f32300af41344b1c0b0bb2
COMPAIR_BASELINE_EMBEDDING_DIMENSION=384
COMPAIR_BASELINE_EMBEDDING_TIMEOUT_SECONDS=10
COMPAIR_BASELINE_EMBEDDING_BATCH_SIZE=32
COMPAIR_BASELINE_EMBEDDING_ALLOW_INSECURE_LOOPBACK=false

# baseline_v1 generation is separate from legacy generation and defaults off.
# The supported native Ollama provider never pulls models or follows redirects.
# Its configured tag is accepted only when /api/tags attests this exact digest.
# HTTP requires both a literal loopback IP and the explicit exception below;
# remote deployments require verified HTTPS.
COMPAIR_BASELINE_GENERATION_PROVIDER=disabled
COMPAIR_BASELINE_GENERATION_ENDPOINT=http://127.0.0.1:11434
COMPAIR_BASELINE_GENERATION_MODEL=qwen3:1.7b
COMPAIR_BASELINE_GENERATION_MODEL_DIGEST=sha256:8f68893c685c3ddff2aa3fffce2aa60a30bb2da65ca488b61fff134a4d1730e7
COMPAIR_BASELINE_GENERATION_MODEL_VERSION=
COMPAIR_BASELINE_GENERATION_TIMEOUT_SECONDS=60
COMPAIR_BASELINE_GENERATION_ALLOW_LOOPBACK_HTTP=false
COMPAIR_BASELINE_GENERATION_MAX_REQUEST_BYTES=256000
COMPAIR_BASELINE_GENERATION_MAX_RESPONSE_BYTES=200000
COMPAIR_BASELINE_GENERATION_CONTEXT_TOKENS=32768
COMPAIR_BASELINE_GENERATION_OUTPUT_TOKENS=1024
COMPAIR_BASELINE_GENERATION_SEED=0

# Baseline-only in-app digest scheduling/delivery. External delivery is unavailable.
COMPAIR_BASELINE_NOTIFICATIONS_ENABLED=false

# Test-only: use a disposable database. Never point tests at production.
# COMPAIR_TEST_POSTGRES_URL=postgresql+psycopg2://test_user:test_password@127.0.0.1:5432/compair_test
